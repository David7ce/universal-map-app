{
  "id": "poi",
  "title": "Points of Interest",
  "kind": "point",
  "source": { "type": "geojson", "url": "/apps/demo/data/poi.geojson" },
  "temporal": { "defaultVisibility": "time-filtered" },
  "taxonomy": [{ "id": "category", "label": "Category", "field": "properties.category" }],
  "regionRole": null,
  "style": { "cluster": true, "icon": "marker" },
  "panel": {
    "showInSearch": true,
    "showInInfo": true,
    "infoFields": [
      { "field": "properties.category", "label": "Category" },
      { "field": "properties.epoca", "label": "Era" },
      { "field": "properties.descripcion", "label": "Description" },
      { "field": "properties.website", "label": "Website", "type": "link" },
      { "field": "properties.photo", "label": "Photo", "type": "image" }
    ]
  }
}
