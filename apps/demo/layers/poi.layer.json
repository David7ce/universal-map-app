{
  "id": "poi",
  "title": "Points of Interest",
  "kind": "point",
  "source": { "type": "geojson", "url": "/apps/demo/data/poi.geojson" },
  "temporal": { "defaultVisibility": "time-filtered" },
  "taxonomy": [{ "id": "categoria", "label": "Category", "field": "properties.categoria" }],
  "regionRole": null,
  "style": { "cluster": true, "icon": "marker" },
  "panel": {
    "showInSearch": true,
    "showInInfo": true,
    "infoFields": [
      { "field": "properties.categoria", "label": "Category" },
      { "field": "properties.web", "label": "Website", "type": "link" },
      { "field": "properties.foto", "label": "Photo", "type": "image" }
    ]
  }
}
