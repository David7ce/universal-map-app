{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universal-map-app/schemas/app-manifest.schema.json",
  "title": "Universal Map app-manifest.json",
  "description": "See docs/json-reference.md for the full field-by-field reference. Mirrors the runtime checks in src/engine/manifests/app-manifest.ts (validateAppManifest) - keep both in sync when either changes.",
  "type": "object",
  "required": ["id", "baseLayers", "dataLayers", "calendar"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "minLength": 1, "description": "App identifier." },
    "title": { "type": "string", "description": "Displayed app title. Not enforced by runtime validation, but always set it." },
    "map": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "center": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2,
          "description": "[lat, lng], Leaflet order - the opposite of GeoJSON coordinates, which are [lng, lat]."
        },
        "zoom": { "type": "number", "description": "Initial zoom level." },
        "crs": {
          "$ref": "#/definitions/mapCrs",
          "description": "Map projection. Defaults to Web Mercator (EPSG:3857) when omitted."
        }
      }
    },
    "baseLayers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/baseLayer" },
      "description": "At least one entry required. The first element is the base layer active by default."
    },
    "dataLayers": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Relative paths to this app's layer.json files, e.g. \"layers/poi.layer.json\". May be empty."
    },
    "calendar": {
      "type": "object",
      "required": ["default", "min", "max"],
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": ["gregorian", "julian", "islamic", "hebrew"],
          "description": "Display only - storage and computation always stay Gregorian/ISO 8601. Defaults to \"gregorian\"."
        },
        "default": {
          "type": "string",
          "pattern": "^(today|\\d{4}-\\d{2}-\\d{2})$",
          "description": "\"today\" seeds from the current date; otherwise an ISO date (YYYY-MM-DD)."
        },
        "min": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "ISO date (YYYY-MM-DD)." },
        "max": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "ISO date (YYYY-MM-DD)." }
      }
    },
    "strings": {
      "type": "string",
      "description": "Relative path (inside the app's folder) to its strings.json. If omitted, t() always falls back to the raw key."
    },
    "plugins": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "participate": {
          "type": "object",
          "required": ["channel", "target", "messageTemplate"],
          "additionalProperties": false,
          "properties": {
            "channel": { "enum": ["email", "whatsapp", "telegram"] },
            "target": {
              "type": "string",
              "minLength": 1,
              "description": "Email, WhatsApp number (no \"+\"), or Telegram user/bot, depending on channel."
            },
            "messageTemplate": {
              "type": "string",
              "minLength": 1,
              "description": "Message text. \"{{date}}\" is replaced with the selected date (YYYY-MM-DD)."
            }
          }
        }
      }
    }
  },
  "definitions": {
    "mapCrs": {
      "oneOf": [
        { "enum": ["EPSG:3857", "EPSG:4326", "Simple"] },
        {
          "type": "object",
          "required": ["proj4def", "resolutions", "origin"],
          "additionalProperties": false,
          "properties": {
            "proj4def": { "type": "string", "minLength": 1, "description": "A proj4 definition string." },
            "resolutions": { "type": "array", "items": { "type": "number" }, "minItems": 1 },
            "origin": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
            "bounds": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }
            }
          }
        }
      ]
    },
    "baseLayer": {
      "type": "object",
      "required": ["id", "title", "type", "url", "attribution"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "type": { "const": "raster-tile", "description": "Only value supported today." },
        "url": { "type": "string", "description": "Tile URL, with {z}/{x}/{y} placeholders." },
        "attribution": { "type": "string" }
      }
    }
  }
}
