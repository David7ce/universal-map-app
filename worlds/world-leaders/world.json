{
  "$schema": "../../docs/schemas/world.schema.json",
  "id": "world-leaders",
  "title": "Líderes del Mundo",
  "map": {
    "center": [
      25,
      10
    ],
    "zoom": 3
  },
  "baseLayers": [
    {
      "id": "osm",
      "title": "Map",
      "type": "raster-tile",
      "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "attribution": "© OSM"
    },
    {
      "id": "satellite",
      "title": "Satellite",
      "type": "raster-tile",
      "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      "attribution": "Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community",
      "labelsUrl": "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}",
      "labelsAttribution": "Tiles © Esri — Source: Esri, Garmin, HERE, and other contributors"
    }
  ],
  "dataLayers": [
    "layers/leaders.layer.json"
  ],
  "calendar": {
    "default": "today",
    "min": "2010-01-01",
    "max": "2030-12-31"
  },
  "strings": "strings.en.json",
  "theme": {
    "primary": "#1b3b6f"
  },
  "systems": {
    "time": false
  },
  "welcome": true
}
