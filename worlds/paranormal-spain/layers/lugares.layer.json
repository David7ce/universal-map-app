{
  "$schema": "../../../docs/schemas/layer.schema.json",
  "id": "paranormal-places",
  "title": "Lugares Paranormales",
  "kind": "point",
  "source": { "type": "geojson", "url": "worlds/paranormal-spain/data/lugares.geojson" },
  "taxonomy": [
    {
      "id": "category",
      "label": "Categoría",
      "field": "properties.category",
      "icons": {
        "Apariciones": "👻",
        "OVNIs": "🛸",
        "Maldiciones": "🪦",
        "Brujería": "🔮",
        "Criaturas Míticas": "🐉",
        "Monstruos Humanoides": "🧛",
        "Desastres Naturales": "🌊",
        "Tragedias": "🔪",
        "Portales": "🌀",
        "Objetos Malditos": "🗿",
        "Lugares de Poder": "⚡"
      },
      "defaultIcon": "❓"
    },
    {
      "id": "verification",
      "label": "Nivel de Verificación",
      "field": "properties.verificationLevel",
      "icons": {
        "Científicamente Estudiado": "🔬",
        "Documentado": "📰",
        "Testimonios Múltiples": "👁️",
        "Leyenda Popular": "📚",
        "Sin Verificar": "❓"
      },
      "defaultIcon": "❓"
    }
  ],
  "regionRole": null,
  "style": {
    "cluster": true,
    "icon": "marker",
    "colorField": "properties.dangerLevel",
    "colorMap": { "Baja": "#4caf7d", "Media": "#e0a83e", "Alta": "#d9534f" },
    "defaultColor": "#9aa3ad"
  },
  "panel": {
    "showInSearch": true,
    "showInInfo": true,
    "infoFields": [
      { "field": "properties.category", "label": "Categoría" },
      { "field": "properties.verificationLevel", "label": "Nivel de Verificación" },
      { "field": "properties.era", "label": "Época" },
      { "field": "properties.municipality", "label": "Municipio" },
      { "field": "properties.phenomena", "label": "Fenómenos" },
      { "field": "properties.activityHours", "label": "Horario de Actividad" },
      { "field": "properties.dangerLevel", "label": "Nivel de Peligro" },
      { "field": "properties.accessibility", "label": "Accesibilidad" },
      { "field": "properties.bestSeason", "label": "Mejor Temporada" },
      { "field": "properties.investigators", "label": "Investigadores" },
      { "field": "properties.howToGetThere", "label": "Cómo Llegar" },
      { "field": "properties.recommendations", "label": "Recomendaciones" },
      { "field": "properties.fullHistory", "label": "Historia Completa" },
      { "field": "properties.video.title", "label": "Video" },
      { "field": "properties.video.url", "label": "Ver Video", "type": "link" },
      { "field": "properties.sources", "label": "Fuentes" }
    ]
  }
}
