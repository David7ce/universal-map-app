{
  "$schema": "../../../docs/schemas/layer.schema.json",
  "id": "poi",
  "title": "Puntos de Interés",
  "kind": "point",
  "source": { "type": "geojson", "url": "worlds/demo/data/poi.geojson" },
  "temporal": { "defaultVisibility": "time-filtered" },
  "taxonomy": [
    {
      "id": "category",
      "label": "Categorías",
      "field": "properties.category",
      "icons": { "park": "🌳", "restaurant": "🍴", "theatre": "🎭" },
      "defaultIcon": "📍"
    }
  ],
  "regionRole": null,
  "style": { "cluster": true, "icon": "marker" },
  "panel": {
    "showInSearch": true,
    "showInInfo": true,
    "infoFields": [{ "field": "properties.category", "label": "Categoría" }]
  }
}
