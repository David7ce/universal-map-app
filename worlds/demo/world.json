{
  "$schema": "../../docs/schemas/world.schema.json",
  "id": "demo",
  "title": "Universal Map Demo",
  "map": { "center": [28.29, -16.62], "zoom": 12 },
  "baseLayers": [
    {
      "id": "osm",
      "title": "Map",
      "type": "raster-tile",
      "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "attribution": "© OpenStreetMap contributors"
    },
    {
      "id": "satellite",
      "title": "Satellite",
      "type": "raster-tile",
      "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      "attribution": "Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community"
    }
  ],
  "dataLayers": ["layers/regions.layer.json", "layers/poi.layer.json", "layers/heatmap.layer.json"],
  "calendar": { "default": "today", "min": "2015-01-01", "max": "2030-12-31" },
  "strings": "strings.json",
  "plugins": {
    "participate": {
      "channel": "email",
      "target": "demo@example.org",
      "messageTemplate": "I want to report something on the map (viewing date: {{date}})"
    }
  }
}
