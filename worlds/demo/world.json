{
  "$schema": "../../docs/schemas/world.schema.json",
  "id": "demo",
  "title": "Demo de Mapa Universal",
  "map": { "center": [28.29, -16.62], "zoom": 12 },
  "baseLayers": [
    {
      "id": "osm",
      "title": "Map",
      "type": "raster-tile",
      "url": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
      "attribution": "© OSM"
    },
    {
      "id": "satellite",
      "title": "Satellite",
      "type": "raster-tile",
      "url": "https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",
      "attribution": "Tiles © Esri — Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community",
      "labelsUrl": "https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}",
      "labelsAttribution": "Tiles © Esri — Source: Esri, Garmin, HERE, and other contributors"
    }
  ],
  "dataLayers": ["layers/regions.layer.json", "layers/poi.layer.json", "layers/heatmap.layer.json"],
  "calendar": { "default": "today", "min": "2015-01-01", "max": "2030-12-31" },
  "strings": "strings.en.json",
  "welcome": {
    "title": "Demo de Mapa Universal",
    "tagline": "Motor espacio-temporal con interfaz web — espacio, tiempo y capas de datos, todo a partir de paquetes de mundos declarativos.",
    "ctaLabel": "Explorar la demo",
    "heroImage": "assets/hero.svg",
    "itemNoun": "puntos de interés",
    "links": [
      { "label": "Paranormal España", "world": "paranormal-spain" },
      { "label": "Eventos de Canarias", "world": "events-canary-islands" },
      { "label": "Fotos de la Luna", "world": "moon-map-photos" }
    ]
  },
  "plugins": {
    "participate": {
      "channel": "email",
      "target": "demo@example.org",
      "messageTemplate": "Quiero informar sobre algo en el mapa (fecha de visualización: {{date}})"
    }
  }
}
