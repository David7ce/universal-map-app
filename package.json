{
  "name": "universal-map-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "tsc --noEmit && vite build",
    "build:paranormal-spain": "tsc --noEmit && vite build --mode paranormal-spain --outDir builds/paranormal-spain",
    "build:events-canary-islands": "tsc --noEmit && vite build --mode events-canary-islands --outDir builds/events-canary-islands",
    "build:moon-map-photos": "tsc --noEmit && vite build --mode moon-map-photos --outDir builds/moon-map-photos",
    "build:world-leaders": "tsc --noEmit && vite build --mode world-leaders --outDir builds/world-leaders",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@turf/boolean-point-in-polygon": "^7.1.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "leaflet.markercluster": "^1.5.3",
    "proj4leaflet": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.14",
    "@types/leaflet": "^1.9.14",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.10.2",
    "@types/proj4leaflet": "^1.0.12",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
